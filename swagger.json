{
  "openapi": "3.0.1",
  "info": {
    "title": "Mercato",
    "description": "API RESTful de supermercado.",
    "version": "1.0",
    "license": {
      "name": "Licença MIT"
    }
  },
  "paths": {
    "/auth/registration": {
      "post": {
        "description": "Cadastra novo usuário.",
        "tags": ["Registration"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "roleId": {
                    "type": "string"
                  },
                  "address": {
                    "type": "object",
                    "required": [
                      "cep",
                      "street",
                      "number",
                      "city",
                      "state",
                      "country"
                    ],
                    "properties": {
                      "cep": {
                        "type": "string"
                      },
                      "street": {
                        "type": "string"
                      },
                      "number": {
                        "type": "number"
                      },
                      "additionalInformation": {
                        "type": "string"
                      },
                      "city": {
                        "type": "string"
                      },
                      "state": {
                        "type": "string"
                      },
                      "country": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "description": "Autentica usuário.",
        "tags": ["Login"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    },
    "/user/{id}": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "description": "Obtém dados de usuário pelo seu id.",
        "tags": ["User"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    },
    "/user/status/{id}": {
      "patch": {
        "security": [{ "BearerAuth": [] }],
        "description": "Altera status de usuário.",
        "tags": ["User"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    },
    "/role/{id}": {
      "put": {
        "security": [{ "BearerAuth": [] }],
        "description": "Atualiza dados de permissão.",
        "tags": ["Role"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "status": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    },
    "/product": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "description": "Obtém todos os produtos cadastrados.",
        "tags": ["Product"],
        "responses": {
          "": {
            "description": ""
          }
        }
      },
      "post": {
        "security": [{ "BearerAuth": [] }],
        "description": "Cadastra novo produto.",
        "tags": ["Product"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "priceInCents": {
                    "type": "number"
                  },
                  "productCategoriesId": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    },
    "/product/{id}": {
      "put": {
        "security": [{ "BearerAuth": [] }],
        "description": "Atualiza dados de produto.",
        "tags": ["Product"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "priceInCents": {
                    "type": "number"
                  },
                  "productCategoriesId": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "": {
            "description": ""
          }
        }
      },
      "delete": {
        "security": [{ "BearerAuth": [] }],
        "description": "Exclui produto.",
        "tags": ["Product"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    },
    "/order/new": {
      "post": {
        "security": [{ "BearerAuth": [] }],
        "description": "Cadastra novo pedido de produtos pelo o usuário.",
        "tags": ["Order"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string"
                  },
                  "products": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "number"
                        },
                        "priceInCents": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    },
    "/order/payment-webhook": {
      "post": {
        "description": "Rota utilizada para receber resposta do webhook do Mercado Pago.",
        "tags": ["Order"]
      }
    },
    "/order/orders-info": {
      "get": {
        "description": "Obtém informações de pedidos realizados por usuários.",
        "tags": ["Order"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
