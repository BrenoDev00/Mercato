{
  "openapi": "3.0.1",
  "info": {
    "title": "Mercato",
    "description": "API RESTful de supermercado.",
    "version": "1.0",
    "license": {
      "name": "Licença MIT"
    }
  },
  "paths": {
    "/auth/registration": {
      "post": {
        "description": "Cadastra novo usuário.",
        "tags": ["Registration"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "roleId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "description": "Autentica usuário.",
        "tags": ["Login"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    },
    "/user/{id}": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "description": "Obtém dados de usuário pelo seu id.",
        "tags": ["User"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    },
    "/user/status/{id}": {
      "patch": {
        "security": [{ "BearerAuth": [] }],
        "description": "Altera status de usuário.",
        "tags": ["User"],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "": {
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
